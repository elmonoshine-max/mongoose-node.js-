<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enviar Correo</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            min-height:100vh;
            display:flex;
            justify-content:center;
            align-items:center;
        }

        .container{
            width:100%;
            max-width:500px;
            background:white;
            padding:35px;
            border-radius:20px;
            box-shadow:0 10px 30px rgba(0,0,0,.2);
        }

        h2{
            text-align:center;
            color:#333;
            margin-bottom:25px;
        }

        .form-group{
            margin-bottom:18px;
        }

        label{
            display:block;
            margin-bottom:8px;
            color:#444;
            font-weight:bold;
        }

        input,
        textarea{
            width:100%;
            padding:12px;
            border:1px solid #ddd;
            border-radius:10px;
            outline:none;
            transition:.3s;
        }

        input:focus,
        textarea:focus{
            border-color:#4f46e5;
            box-shadow:0 0 8px rgba(79,70,229,.3);
        }

        textarea{
            resize:none;
        }

        button{
            width:100%;
            padding:14px;
            border:none;
            border-radius:10px;
            background:#4f46e5;
            color:white;
            font-size:16px;
            font-weight:bold;
            cursor:pointer;
            transition:.3s;
        }

        button:hover{
            background:#4338ca;
            transform:translateY(-2px);
        }

        .icon{
            text-align:center;
            font-size:50px;
            margin-bottom:10px;
        }
    </style>
</head>
<body>

    <div class="container">

        <div class="icon">📧</div>

        <h2>Enviar Correo</h2>

        <form action="/enviar" method="POST">

            <div class="form-group">
                <label>Correo destino</label>
                <input type="email" name="correo" placeholder="ejemplo@gmail.com" required>
            </div>

            <div class="form-group">
                <label>Asunto</label>
                <input type="text" name="asunto" placeholder="Escribe el asunto" required>
            </div>

            <div class="form-group">
                <label>Mensaje</label>
                <textarea name="mensaje" rows="6" placeholder="Escribe tu mensaje aquí..." required></textarea>
            </div>

            <button type="submit">
                Enviar Correo
            </button>

        </form>

    </div>

</body>
</html>